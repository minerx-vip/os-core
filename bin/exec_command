#!/bin/bash


command_id=$1
command_str=$2
log_file="/var/log/os/${command_id}.log"
rm -f ${log_file}

cleanup_ttyd_proxy() {
    if screen -list | grep -q "\.ttyd_proxy"; then
        echo "Found screen session 'ttyd_proxy'. Exiting it..."
        screen -S ttyd_proxy -X quit
        sleep 1
    fi

    if [[ -x /os/bin/ttyd_proxy ]]; then
        /os/bin/ttyd_proxy cleanup >/dev/null 2>&1 || true
    fi
}

is_ttyd_proxy_command() {
    [[ "${command_str}" == "ttyd_proxy" ]] ||
    [[ "${command_str}" == "ttyd_proxy "* ]] ||
    [[ "${command_str}" == "/os/bin/ttyd_proxy" ]] ||
    [[ "${command_str}" == "/os/bin/ttyd_proxy "* ]]
}


##################################################################
## Start Remote Shell - sshx
##################################################################
if [[ ${command_str} == 'sshx' ]]; then
    ## Exit the existing sshx
    if screen -list | grep -q "\.os_sshx"; then
        echo "Found screen session 'os_sshx'. Exiting it..."
        screen -S os_sshx -X quit
    fi

    ## Start sshx
    screen -dmL -Logfile ${log_file} -S os_sshx /os/bin/remote-sshx

    ## Sending message to server
    count=0
    while (( count < 30 )); do
        (( count++ ))

        if [[ -f ${log_file} ]] && grep -q "Link:" "${log_file}"; then
            /os/bin/say-message ok --file=${log_file} --id=${command_id}
            exit
        fi

        echo "Waiting for sshx to start successfully ${count}"
        sleep 1
    done

    echo "ERROR: sshx did not start successfully within 30 seconds" | tee -a ${log_file}
    screen -S os_sshx -X quit 2>/dev/null || true
    /os/bin/say-message error --file=${log_file} --id=${command_id}
    exit 1
fi

##################################################################
## Start Remote Shell - minerX SSH Proxy
##################################################################
if is_ttyd_proxy_command; then
    ## Exit the existing ttyd_proxy
    cleanup_ttyd_proxy

    ## Start ttyd_proxy
    screen -dmL -Logfile ${log_file} -S ttyd_proxy /os/bin/ttyd_proxy

    ## Sending message to server
    count=0
    while (( count < 30 )); do
        (( count++ ))

        if [[ -f ${log_file} ]] && grep -q "Link:" "${log_file}"; then
            /os/bin/say-message ok --file=${log_file} --id=${command_id}
            exit
        fi

        echo "Waiting for ttyd_proxy to start successfully ${count}"
        sleep 1
    done

    echo "ERROR: ttyd_proxy did not start successfully within 30 seconds" | tee -a ${log_file}
    cleanup_ttyd_proxy
    /os/bin/say-message error --file=${log_file} --id=${command_id}
    exit 1
fi


##################################################################
## Reboot —— 硬重启：内核 SysRq，绕过 systemd 优雅停机；带 90s 兜底
##################################################################
if [[ ${command_str} == 'reboot' ]]; then
    echo "Rebooting (forced via sysrq)..."
    echo 1 > /proc/sys/kernel/sysrq 2>/dev/null
    # 1) 90s 兜底：无论后续卡在哪都会强制重启
    nohup bash -c 'sleep 90; echo 1 >/proc/sys/kernel/sysrq; echo b >/proc/sysrq-trigger; reboot -f' >/dev/null 2>&1 &
    # 2) 最佳努力回执（后台，避免 say-message 重试阻塞重启）
    /os/bin/say-message ok "Rebooting" --id=${command_id} >/dev/null 2>&1 &
    # 3) （可选）杀硬件看门狗喂狗，避免它抢先复位；没有对应进程则无副作用
    killall -s 9 watchdog-octofan hl340 watchdoginua 2>/dev/null
    # 4) sync 刷盘 -> remount ro（best-effort）-> 内核级强制重启
    sync
    echo s > /proc/sysrq-trigger 2>/dev/null
    echo u > /proc/sysrq-trigger 2>/dev/null
    sleep 1
    echo b > /proc/sysrq-trigger 2>/dev/null
    reboot -f
    exit 0
fi

##################################################################
## Shutdown —— 硬关机：内核 SysRq poweroff；带 90s 兜底
##################################################################
if [[ ${command_str} == 'shutdown' ]]; then
    echo "Shutting down (forced via sysrq)..."
    echo 1 > /proc/sys/kernel/sysrq 2>/dev/null
    nohup bash -c 'sleep 90; echo 1 >/proc/sys/kernel/sysrq; echo o >/proc/sysrq-trigger; poweroff -f' >/dev/null 2>&1 &
    /os/bin/say-message ok "Shutting down" --id=${command_id} >/dev/null 2>&1 &
    killall -s 9 watchdog-octofan hl340 watchdoginua 2>/dev/null
    sync
    echo s > /proc/sysrq-trigger 2>/dev/null
    echo u > /proc/sysrq-trigger 2>/dev/null
    sleep 1
    echo o > /proc/sysrq-trigger 2>/dev/null
    poweroff -f
    exit 0
fi

## 强制将某些命令使用完整路径
[[ ${command_str} == 'hive_disable' ]] && command_str='/os/bin/hive_disable'
[[ ${command_str} == 'os-update' ]] && command_str='/os/bin/os-update'
[[ ${command_str} == os-log* ]] && command_str="/os/bin/os-log${command_str#os-log}"

##################################################################
## Other
##################################################################
## Start
printf "Exec Command: %s\n" "${command_str}" | tee -a ${log_file}

# 使用 eval 或 bash -c 执行命令，防止 command_str 解析错误
eval "${command_str}" &> >(tee -a ${log_file})
# 或者
# bash -c "${command_str}" &> >(tee -a ${log_file})

# 获取命令的退出状态
if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
    /os/bin/say-message ok --file=${log_file} --id=${command_id}
else
    /os/bin/say-message error --file=${log_file} --id=${command_id}
fi
