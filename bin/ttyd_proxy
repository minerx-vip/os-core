#!/bin/bash



tag_debug=0     # 是否开启 Debug 模式
cleanup_only=0  # 仅清理现有 ttyd_proxy 进程
for var in "$@"; do
    case "$var" in
        debug) tag_debug=1;;
        cleanup|stop) cleanup_only=1;;
    esac
done

ttyd_pid=""
ssh_pid=""

kill_matching_processes() {
    local pattern="$1"
    local label="$2"
    local pids

    pids=$(pgrep -f "$pattern" 2>/dev/null | tr '\n' ' ' || true)
    [[ -z "$pids" ]] && return 0

    echo "清理旧的 ${label} 进程: ${pids}"
    kill ${pids} 2>/dev/null || true
    sleep 1

    pids=$(pgrep -f "$pattern" 2>/dev/null | tr '\n' ' ' || true)
    [[ -n "$pids" ]] && kill -9 ${pids} 2>/dev/null || true
}

cleanup_existing_proxy() {
    kill_matching_processes 'ttyd[[:space:]].*-p[[:space:]]+4201([[:space:]]|$)' "ttyd 4201"
    kill_matching_processes 'ssh[[:space:]].*-R[[:space:]]+[^[:space:]]*:127\.0\.0\.1:4201([[:space:]]|$)' "SSH 反向隧道 4201"
}

cleanup_children() {
    local exit_code=$?
    trap - EXIT INT TERM HUP

    if [[ -n "$ssh_pid" ]] && kill -0 "$ssh_pid" 2>/dev/null; then
        echo "清理 SSH 隧道 (PID: $ssh_pid)"
        kill "$ssh_pid" 2>/dev/null || true
    fi

    if [[ -n "$ttyd_pid" ]] && kill -0 "$ttyd_pid" 2>/dev/null; then
        echo "清理 ttyd 服务 (PID: $ttyd_pid)"
        kill "$ttyd_pid" 2>/dev/null || true
    fi

    sleep 1

    [[ -n "$ssh_pid" ]] && kill -0 "$ssh_pid" 2>/dev/null && kill -9 "$ssh_pid" 2>/dev/null || true
    [[ -n "$ttyd_pid" ]] && kill -0 "$ttyd_pid" 2>/dev/null && kill -9 "$ttyd_pid" 2>/dev/null || true

    wait "$ssh_pid" 2>/dev/null || true
    wait "$ttyd_pid" 2>/dev/null || true
    exit "$exit_code"
}

if [[ ${cleanup_only} == 1 ]]; then
    cleanup_existing_proxy
    exit 0
fi

cleanup_existing_proxy
trap cleanup_children EXIT INT TERM HUP

start_ttyd() {
    ## 运行 ttyd 服务
    echo "启动 ttyd 服务..."
    
    # 启动 ttyd
    $shell_ttyd > /dev/null 2>&1 &
    ttyd_pid=$!
    
    if [[ -z "$ttyd_pid" ]] || ! kill -0 $ttyd_pid 2>/dev/null; then
        echo "错误: 无法启动 ttyd 服务"
        exit 1
    fi
    
    echo "ttyd 服务已启动 (PID: $ttyd_pid)"
    
    # 等待 ttyd 服务启动
    sleep 2
    
    # 检查 ttyd 是否仍在运行
    if ! kill -0 $ttyd_pid 2>/dev/null; then
        echo "错误: ttyd 服务启动后意外退出"
        exit 1
    fi
    
    # 启动 SSH 隧道（在后台运行）
    echo "正在建立 SSH 隧道..."
    $shell_ssh -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 &
    ssh_pid=$!
    
    # 等待 SSH 隧道建立
    sleep 2
    
    # 检查 SSH 隧道是否建立成功
    if ! kill -0 $ssh_pid 2>/dev/null; then
        echo "错误: SSH 隧道建立失败"
        kill $ttyd_pid 2>/dev/null
        exit 1
    fi

    echo "SSH 隧道建立成功 (PID: $ssh_pid)"
    echo
    echo
    echo "Link: $fullPath"

    while true; do
        if ! kill -0 $ttyd_pid 2>/dev/null; then
            echo "错误: ttyd 服务已退出"
            return 1
        fi

        if ! kill -0 $ssh_pid 2>/dev/null; then
            echo "错误: SSH 隧道已退出"
            return 1
        fi

        sleep 5
    done
}


## 加载配置文件
source /os/config/rig.conf

## 输出调试信息
[[ ${tag_debug} == 1 ]] && echo "Debug ssh_proxy_server_1 = $ssh_proxy_server_1"
[[ ${tag_debug} == 1 ]] && echo "Debug ssh_proxy_server_2 = $ssh_proxy_server_2"
[[ ${tag_debug} == 1 ]] && echo "Debug ssh_proxy_api_port = $ssh_proxy_api_port"
[[ ${tag_debug} == 1 ]] && echo "Debug ssh_proxy_token = $ssh_proxy_token"

## 拼接请求参数
api_1="http://${ssh_proxy_server_1}:${ssh_proxy_api_port}/api/ports/first-available"
api_2="http://${ssh_proxy_server_2}:${ssh_proxy_api_port}/api/ports/first-available"

## 下载私钥文件
private_key_file="/os/etc/id_rsa"
cat <<\EOF > ${private_key_file}
-----BEGIN OPENSSH PRIVATE KEY-----
