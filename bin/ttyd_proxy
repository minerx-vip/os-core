L0MtGIPdIRc3XlAAAADnJvb3RAcmVwb3J0LWNuAQIDBA==
-----END OPENSSH PRIVATE KEY-----
EOF
chmod 600 ${private_key_file}


## 尝试使用 api_1
echo "尝试连接 API 1"
response=$(curl -sS -H \
    "Author1zation: Bearer ${ssh_proxy_token}" \
    --connect-timeout 7 --max-time 15 \
    "${api_1}" 2>/dev/null)
exitcode=$?

## 如果 api_1 失败，尝试使用 api_2
if [ $exitcode -ne 0 ] || [ -z "$response" ]; then
    echo "API 1 连接失败，尝试连接 API 2"
    response=$(curl -sS -H \
        "Author1zation: Bearer ${ssh_proxy_token}" \
        --connect-timeout 7 --max-time 15 \
        "${api_2}" 2>/dev/null)
    exitcode=$?
    
    # 如果 api_2 也失败，则退出
    if [ $exitcode -ne 0 ] || [ -z "$response" ]; then
        echo "错误: 无法连接到任何 API 服务器"
        exit 1
    fi
fi

[[ ${tag_debug} == 1 ]] && echo "Debug 命令结果: ${exitcode}"
[[ ${tag_debug} == 1 ]] && echo "Debug 原始数据: $response"

## 获取远程服务器信息
remotePort=$(echo $response | jq '.remotePort' --raw-output)
[[ ${tag_debug} == 1 ]] && echo "Debug remotePort = $remotePort"
if [[ -z "${remotePort}" ]] || [[ ${remotePort} == "null" ]] || [[ ${remotePort} == "0" ]]; then
    echo "失败"
else
    remoteHost=$(echo $response | jq '.remoteHost' --raw-output)
    remoteSshPort=$(echo $response | jq '.remoteSshPort' --raw-output)
    fullPath=$(echo $response | jq '.fullPath' --raw-output)
    [[ ${tag_debug} == 1 ]] && echo "Debug remoteHost = $remoteHost"
    [[ ${tag_debug} == 1 ]] && echo "Debug remoteSshPort = $remoteSshPort"
    [[ ${tag_debug} == 1 ]] && echo "Debug fullPath = $fullPath"

    ## 运行反向代理
    # shell_ttyd="ttyd -p 4201 --check-origin=false bash"
    shell_ttyd="/os/bin/ttyd -p 4201 --check-origin=false /bin/bash -l"
    shell_ssh="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i ${private_key_file} -N -R ${remotePort}:127.0.0.1:4201 root@${remoteHost} -p ${remoteSshPort}"
    [[ ${tag_debug} == 1 ]] && echo "Debug shell_ttyd = $shell_ttyd"
    [[ ${tag_debug} == 1 ]] && echo "Debug shell_ssh = $shell_ssh"

    ## 启动反向代理
    start_ttyd
fi
